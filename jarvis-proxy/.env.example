# Copy this file to ".env" (same folder as server.py) and fill in a real key.
# Never commit the real .env file anywhere public.

# Get a key at https://console.anthropic.com -> Settings -> API Keys.
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional fallback if Anthropic auth fails. Get a key at https://console.groq.com.
GROQ_API_KEY=your_groq_api_key_here
